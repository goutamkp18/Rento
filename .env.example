# ==========================================
# RENTO BACKEND CONFIGURATION (.env)
# ==========================================
# Provide your Supabase project credentials to connect real backend data.
# When left empty, Rento operates in genuine local browser persistence mode
# with zero pre-seeded fake data.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
